rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isToptanci(uid) {
      return exists(/databases/$(database)/documents/isletmeler/$(uid))
        && get(/databases/$(database)/documents/isletmeler/$(uid)).data.tip == 'toptanci';
    }

    function isApprovedMagaza(uid) {
      return exists(/databases/$(database)/documents/isletmeler/$(uid))
        && get(/databases/$(database)/documents/isletmeler/$(uid)).data.tip == 'magaza'
        && get(/databases/$(database)/documents/isletmeler/$(uid)).data.status == 'approved';
    }

    function isOrderToptanciValid() {
      return request.resource.data.toptanciId is string
        && exists(/databases/$(database)/documents/isletmeler/$(request.resource.data.toptanciId))
        && get(/databases/$(database)/documents/isletmeler/$(request.resource.data.toptanciId)).data.tip == 'toptanci';
    }

    function isValidOrderCreate() {
      return signedIn()
        && isApprovedMagaza(request.auth.uid)
        && request.resource.data.keys().hasOnly([
          'toptanciId',
          'customer_uid',
          'toptanci_info',
          'customer_info',
          'items',
          'total_pairs',
          'total_amount',
          'status',
          'wa_notified',
          'created_at',
          'updated_at'
        ])
        && request.resource.data.customer_uid == request.auth.uid
        && isOrderToptanciValid()
        && request.resource.data.customer_info is map
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total_pairs is number
        && request.resource.data.total_pairs > 0
        && request.resource.data.total_amount is number
        && request.resource.data.total_amount >= 0
        && request.resource.data.status == 'pending'
        && request.resource.data.wa_notified == false;
    }

    match /products/{docId} {
      allow read: if true;
      allow create: if request.auth != null
        && isToptanci(request.auth.uid)
        && request.resource.data.toptanciId == request.auth.uid;
      allow update: if request.auth != null
        && isToptanci(request.auth.uid)
        && resource.data.toptanciId == request.auth.uid
        && request.resource.data.toptanciId == resource.data.toptanciId;
      allow delete: if false;
    }
    match /toptancilar/{toptanciId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if false;
    }
    match /isletmeler/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        resource.data.tip == 'toptanci' ||
        (isToptanci(request.auth.uid) && resource.data.tip == 'magaza')
      );
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.tip == 'magaza'
        && request.resource.data.status == 'pending';
      allow update: if signedIn() && (
        (
          request.auth.uid == uid
          && request.resource.data.tip == resource.data.tip
          && (
            resource.data.tip == 'toptanci' ||
            (
              resource.data.tip == 'magaza'
              && request.resource.data.status == resource.data.status
              && resource.data.status != 'rejected'
            )
          )
        )
        ||
        (
          isToptanci(request.auth.uid)
          && resource.data.tip == 'magaza'
          && resource.data.status == 'pending'
          && request.resource.data.tip == resource.data.tip
          && request.resource.data.status in ['approved', 'rejected']
        )
      );
      allow delete: if false;
    }
    match /orders/{docId} {
      allow create: if isValidOrderCreate();
      allow read: if request.auth != null && (
        resource.data.toptanciId == request.auth.uid ||
        resource.data.customer_uid == request.auth.uid
      );
      allow update: if request.auth != null
        && resource.data.toptanciId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at'])
        && request.resource.data.status in ['pending', 'approved', 'shipped', 'delivered', 'cancelled'];
      allow delete: if false;
    }
    // Mağaza sahibi: kendi belgesi; toptancılar başvuruları okuyup onay/red
    match /magaza_sahipleri/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        isToptanci(request.auth.uid)
      );
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null && (
        (
          request.auth.uid == uid
          && request.resource.data.status == resource.data.status
          && resource.data.status != 'rejected'
        )
        ||
        (
          isToptanci(request.auth.uid)
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
        )
      );
      allow delete: if false;
    }
  }
}
