rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{docId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.toptanciId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.toptanciId == request.auth.uid
        && request.resource.data.toptanciId == resource.data.toptanciId;
      allow delete: if false;
    }
    match /toptancilar/{toptanciId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == toptanciId;
      allow delete: if false;
    }
    match /orders/{docId} {
      allow create: if true;
      allow read, update: if request.auth != null && resource.data.toptanciId == request.auth.uid;
      allow delete: if false;
    }
    // Mağaza sahibi: kendi belgesi; toptancılar başvuruları okuyup onay/red
    match /magaza_sahipleri/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        exists(/databases/$(database)/documents/toptancilar/$(request.auth.uid))
      );
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null && (
        (
          request.auth.uid == uid
          && request.resource.data.status == resource.data.status
          && resource.data.status != 'rejected'
        )
        ||
        (
          exists(/databases/$(database)/documents/toptancilar/$(request.auth.uid))
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
        )
      );
      allow delete: if false;
    }
  }
}
