rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Resim yükleme ve okuma
    match /productImages/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Diğer tüm yüklemeler yasak
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
